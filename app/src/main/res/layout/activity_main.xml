      <LinearLayout android:layout_width="match_parent" android:layout_height="88dp" android:background="@color/devxyz_panel_2" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center_vertical" android:paddingLeft="8dp" android:text="LOG / PROBLEMS" android:textColor="@color/devxyz_muted" android:textSize="9sp"/><ScrollView android:id="@+id/consoleScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><TextView android:id="@+id/consoleText" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="6dp" android:text="DevxyzIDE ready. Create or import an Android project to begin." android:textColor="@color/devxyz_text" android:textSize="10sp" android:typeface="monospace"/></ScrollView></LinearLayout>
    </LinearLayout>
    <ScrollView android:id="@+id/workspace_search" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/devxyz_bg" android:visibility="gone"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SEARCH" android:textColor="@color/devxyz_cyan" android:textSize="18sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/devxyz_card" android:padding="12dp" android:text="Find text in the current file or search across the active project." android:textColor="@color/devxyz_muted"/><Button android:id="@+id/searchButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="12dp" android:background="@drawable/devxyz_reference_button_v2" android:text="Find in File" android:textColor="@color/devxyz_text"/><Button android:id="@+id/projectSearchButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:background="@drawable/devxyz_reference_button_v2" android:text="Search Project" android:textColor="@color/devxyz_text"/></LinearLayout></ScrollView>
    <ScrollView android:id="@+id/workspace_git" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/devxyz_bg" android:visibility="gone"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SOURCE CONTROL" android:textColor="@color/devxyz_cyan" android:textSize="18sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/devxyz_card" android:padding="12dp" android:text="Inspect status, branches, changes and Git operations for the active project." android:textColor="@color/devxyz_muted"/><com.jepongdevxyz.idebuild.GitButton android:id="@+id/gitButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="12dp" android:background="@drawable/devxyz_reference_button_v2" android:text="Open Git Tools" android:textColor="@color/devxyz_text"/></LinearLayout></ScrollView>
