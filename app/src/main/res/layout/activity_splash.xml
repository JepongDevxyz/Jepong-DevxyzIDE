<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/devxyz_bg" android:gravity="center"
    android:orientation="vertical" android:padding="30dp">
    <ImageView android:layout_width="148dp" android:layout_height="148dp"
        android:contentDescription="@string/app_name" android:src="@mipmap/ic_launcher"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:text="DevxyzIDE" android:textColor="@color/devxyz_text"
        android:textSize="32sp" android:textStyle="bold"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="CODE  •  BUILD  •  CREATE"
        android:textColor="@color/devxyz_cyan" android:textSize="12sp" android:letterSpacing="0.12"/>
    <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="210dp"
        android:layout_height="4dp" android:layout_marginTop="38dp" android:indeterminate="true"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:text="Initializing your creative environment…"
        android:textColor="@color/devxyz_muted" android:textSize="11sp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="28dp" android:text="Powered by Jepong Devxyz"
        android:textColor="@color/devxyz_muted" android:textSize="11sp"/>
</LinearLayout>