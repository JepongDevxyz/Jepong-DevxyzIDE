<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:contentDescription="Back" />

            <TextView
                android:id="@+id/editor_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MainActivity.java"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="middle" />

            <ImageButton
                android:id="@+id/btn_editor_search"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_search"
                android:contentDescription="Find in file" />

            <ImageButton
                android:id="@+id/btn_editor_overflow"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_overflow"
                android:contentDescription="Editor options" />
        </LinearLayout>

        <!-- File tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:background="@color/panel">

            <LinearLayout
                android:id="@+id/tab_java"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="MainActivity.java"
                    android:textColor="@color/cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/underline_java"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/cyan" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_xml"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="activity_main.xml"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <View
                    android:id="@+id/underline_xml"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@android:color/transparent" />
            </LinearLayout>
        </LinearLayout>

        <!-- Code area with line numbers -->
        <ScrollView
            android:id="@+id/code_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:background="@color/navy">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/line_numbers"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:fontFamily="monospace"
                        android:textSize="13sp"
                        android:textColor="@color/muted"
                        android:gravity="end"
                        android:paddingEnd="12dp"
                        android:lineSpacingExtra="2dp" />

                    <EditText
                        android:id="@+id/editor"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:minWidth="600dp"
                        android:gravity="top|start"
                        android:fontFamily="monospace"
                        android:textSize="13sp"
                        android:textColor="@color/text"
                        android:textColorHint="@color/muted"
                        android:hint="Open a file from Projects to start coding…"
                        android:background="@android:color/transparent"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:lineSpacingExtra="2dp"
                        android:scrollbars="none" />
                </LinearLayout>
            </HorizontalScrollView>
        </ScrollView>

        <!-- Bottom editor tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@color/panel"
            android:paddingEnd="88dp">

            <TextView
                android:id="@+id/tab_code"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Code"
                android:textColor="@color/cyan"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/tab_terminal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Terminal"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/tab_log"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Log"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/tab_problems"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Problems"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:background="?attr/selectableItemBackground" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_play"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="72dp"
        android:src="@drawable/ic_play"
        android:contentDescription="Build and run"
        app:fabCustomSize="60dp"
        app:backgroundTint="@color/blue"
        app:tint="@android:color/white" />

</FrameLayout>
