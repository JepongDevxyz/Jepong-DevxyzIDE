    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal"><ImageView android:layout_width="36dp" android:layout_height="36dp" android:contentDescription="@string/app_name" android:src="@mipmap/ic_launcher"/><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:orientation="vertical"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Devxyz" android:textColor="@color/devxyz_text" android:textSize="20sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="IDE" android:textColor="@color/devxyz_cyan" android:textSize="19sp" android:textStyle="bold"/></LinearLayout><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A Powerful Android IDE on Mobile" android:textColor="@color/devxyz_muted" android:textSize="8sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CODE • BUILD • CREATE" android:textColor="@color/devxyz_cyan" android:textSize="9sp" android:letterSpacing="0.08"/></LinearLayout></LinearLayout>
    <Button android:id="@+id/createProjectButton" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/devxyz_fab" android:text="+" android:textColor="@color/devxyz_bg" android:textSize="24sp"/>
  </LinearLayout>
  <TextView android:id="@+id/projectPath" android:layout_width="match_parent" android:layout_height="34dp" android:background="@color/devxyz_panel_2" android:ellipsize="middle" android:gravity="center_vertical" android:maxLines="1" android:paddingLeft="14dp" android:paddingRight="14dp" android:text="@string/no_project" android:textColor="@color/devxyz_muted" android:textSize="11sp"/>
