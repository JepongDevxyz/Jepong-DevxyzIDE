<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/devxyz_bg" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:background="@color/devxyz_panel" android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="14dp" android:paddingRight="10dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DevxyzIDE" android:textColor="@color/devxyz_text" android:textSize="19sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CODE • BUILD • CREATE" android:textColor="@color/devxyz_cyan" android:textSize="9sp"/></LinearLayout>
        <Button android:id="@+id/createProjectButton" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/devxyz_fab" android:text="+" android:textColor="@color/devxyz_bg" android:textSize="24sp"/>
    </LinearLayout>
    <TextView android:id="@+id/projectPath" android:layout_width="match_parent" android:layout_height="32dp" android:background="@color/devxyz_panel" android:ellipsize="middle" android:gravity="center_vertical" android:maxLines="1" android:paddingLeft="14dp" android:paddingRight="14dp" android:text="@string/no_project" android:textColor="@color/devxyz_muted" android:textSize="11sp"/>
    <HorizontalScrollView android:id="@+id/tabScroll" android:layout_width="match_parent" android:layout_height="38dp" android:background="@color/devxyz_panel_2" android:scrollbars="none"><LinearLayout android:id="@+id/tabBar" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="8dp" android:paddingRight="8dp"/></HorizontalScrollView>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/workspace_files" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
            <LinearLayout android:id="@+id/workspaceBody" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
                <LinearLayout android:id="@+id/projectPane" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.34" android:background="@color/devxyz_panel" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="12dp" android:paddingRight="8dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="PROJECT EXPLORER" android:textColor="@color/devxyz_text" android:textSize="12sp" android:textStyle="bold"/><Button android:id="@+id/newFileButton" android:layout_width="36dp" android:layout_height="32dp" android:background="@android:color/transparent" android:enabled="false" android:text="＋" android:textColor="@color/devxyz_cyan" android:textSize="18sp"/><Button android:id="@+id/newFolderButton" android:layout_width="36dp" android:layout_height="32dp" android:background="@android:color/transparent" android:enabled="false" android:text="▣" android:textColor="@color/devxyz_muted" android:textSize="15sp"/></LinearLayout>
                    <ListView android:id="@+id/fileList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@color/devxyz_line" android:dividerHeight="1dp"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/devxyz_line"/>
                <LinearLayout android:id="@+id/editorPane" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.66" android:background="@color/devxyz_bg" android:orientation="vertical">
                    <LinearLayout android:id="@+id/workspace_editor" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"><com.jepongdevxyz.idebuild.SyntaxEditText android:id="@+id/editor" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@color/devxyz_bg" android:gravity="top|start" android:inputType="textMultiLine|textNoSuggestions" android:padding="10dp" android:textColor="@color/devxyz_text" android:textSize="13sp" android:typeface="monospace"/></LinearLayout>
                    <LinearLayout android:id="@+id/editorBottomNavigation" android:layout_width="match_parent" android:layout_height="44dp" android:background="@color/devxyz_panel_2" android:gravity="center" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Code" android:textColor="@color/devxyz_cyan" android:textSize="11sp"/><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Terminal" android:textColor="@color/devxyz_muted" android:textSize="11sp"/><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Log" android:textColor="@color/devxyz_muted" android:textSize="11sp"/><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Problems" android:textColor="@color/devxyz_muted" android:textSize="11sp"/></LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="96dp" android:background="@color/devxyz_panel_2" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center_vertical" android:paddingLeft="10dp" android:text="LOG / PROBLEMS" android:textColor="@color/devxyz_muted" android:textSize="10sp" android:textStyle="bold"/><ScrollView android:id="@+id/consoleScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><TextView android:id="@+id/consoleText" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:text="DevxyzIDE ready. Create or import an Android project to begin." android:textColor="@color/devxyz_text" android:textSize="10sp" android:typeface="monospace"/></ScrollView></LinearLayout>
        </LinearLayout>
        <ScrollView android:id="@+id/workspace_build_tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/devxyz_bg" android:visibility="gone"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="BUILD &amp; RUN" android:textColor="@color/devxyz_cyan" android:textSize="18sp" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/devxyz_card" android:padding="14dp" android:text="Compile the active project, inspect the real build log, then install the generated APK." android:textColor="@color/devxyz_text" android:textSize="12sp"/>
            <Button android:id="@+id/buildButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="12dp" android:background="@drawable/devxyz_primary_button" android:text="Build Project" android:textColor="@color/devxyz_bg"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal"><Button android:id="@+id/installButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:enabled="false" android:text="Install APK"/><com.jepongdevxyz.idebuild.BuildActionsButton android:id="@+id/buildActionsButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Build Actions"/></LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="BUILT-IN TOOLS" android:textColor="@color/devxyz_cyan" android:textSize="18sp" android:textStyle="bold"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/devxyz_card" android:orientation="vertical" android:padding="10dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Utilities" android:textColor="@color/devxyz_text" android:textStyle="bold"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><com.jepongdevxyz.idebuild.TerminalButton android:id="@+id/terminalButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Terminal"/><com.jepongdevxyz.idebuild.GitButton android:id="@+id/gitButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Git"/></LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><com.jepongdevxyz.idebuild.ApkSigningButton android:id="@+id/signApkButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="APK Signer"/><com.jepongdevxyz.idebuild.DeveloperToolsButton android:id="@+id/developerToolsButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Dev Tools"/></LinearLayout>
            </LinearLayout>
        </LinearLayout></ScrollView>
        <ScrollView android:id="@+id/workspace_more" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/devxyz_bg" android:visibility="gone"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SETTINGS" android:textColor="@color/devxyz_cyan" android:textSize="18sp" android:textStyle="bold"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/devxyz_card" android:orientation="vertical" android:padding="12dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Editor" android:textColor="@color/devxyz_text" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp" android:text="Font Size • Word Wrap • Autosave" android:textColor="@color/devxyz_muted"/><com.jepongdevxyz.idebuild.EditorSettingsButton android:id="@+id/settingsButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="Editor Settings"/><View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:background="@color/devxyz_line"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:text="Project &amp; Build" android:textColor="@color/devxyz_text" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp" android:text="Gradle • JDK • Android SDK • project metadata" android:textColor="@color/devxyz_muted"/><com.jepongdevxyz.idebuild.ProjectSettingsButton android:id="@+id/projectSettingsButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="Project Settings"/></LinearLayout>
        </LinearLayout></ScrollView>
    </FrameLayout>
    <LinearLayout android:id="@+id/bottomNavigation" android:layout_width="match_parent" android:layout_height="52dp" android:background="@color/devxyz_panel" android:gravity="center" android:orientation="horizontal" android:padding="3dp"><com.jepongdevxyz.idebuild.WorkspaceNavigationButton android:id="@+id/nav_files" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Files"/><com.jepongdevxyz.idebuild.WorkspaceNavigationButton android:id="@+id/nav_search" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Search"/><com.jepongdevxyz.idebuild.WorkspaceNavigationButton android:id="@+id/nav_git" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Git"/><com.jepongdevxyz.idebuild.WorkspaceNavigationButton android:id="@+id/nav_build_tools" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Build"/><com.jepongdevxyz.idebuild.WorkspaceNavigationButton android:id="@+id/nav_more" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="More"/></LinearLayout>
    <LinearLayout android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"><Button android:id="@+id/recentProjectsButton" android:layout_width="1dp" android:layout_height="1dp"/><com.jepongdevxyz.idebuild.CancelableImportButton android:id="@+id/importButton" android:layout_width="1dp" android:layout_height="1dp"/><Button android:id="@+id/backupButton" android:layout_width="1dp" android:layout_height="1dp"/><Button android:id="@+id/toolchainButton" android:layout_width="1dp" android:layout_height="1dp"/><com.jepongdevxyz.idebuild.ToolchainManagerButton android:id="@+id/sdkManagerButton" android:layout_width="1dp" android:layout_height="1dp"/><Button android:id="@+id/runtimeButton" android:layout_width="1dp" android:layout_height="1dp"/><Button android:id="@+id/projectSearchButton" android:layout_width="1dp" android:layout_height="1dp"/><Button android:id="@+id/searchButton" android:layout_width="1dp" android:layout_height="1dp"/><Button android:id="@+id/problemsButton" android:layout_width="1dp" android:layout_height="1dp"/><Button android:id="@+id/saveButton" android:layout_width="1dp" android:layout_height="1dp"/><Button android:id="@+id/saveAllButton" android:layout_width="1dp" android:layout_height="1dp"/><com.jepongdevxyz.idebuild.CompletionButton android:id="@+id/completionButton" android:layout_width="1dp" android:layout_height="1dp"/><com.jepongdevxyz.idebuild.EditorActionsButton android:id="@+id/editorActionsButton" android:layout_width="1dp" android:layout_height="1dp"/></LinearLayout>
</LinearLayout>