          <LinearLayout android:layout_width="match_parent" android:layout_height="38dp" android:orientation="horizontal" android:paddingLeft="6dp" android:paddingRight="6dp"><com.jepongdevxyz.idebuild.CancelableImportButton android:id="@+id/importButton" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:background="@drawable/devxyz_reference_button_v2" android:text="Import" android:textColor="@color/devxyz_text"/><Button android:id="@+id/recentProjectsButton" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:background="@drawable/devxyz_reference_button_v2" android:text="Recent" android:textColor="@color/devxyz_text"/></LinearLayout>
