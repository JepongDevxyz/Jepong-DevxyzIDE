inalButton android:id="@+id/terminalButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:background="@drawable/devxyz_reference_button_v2" android:text="Terminal" android:textColor="@color/devxyz_text"/><com.jepongdevxyz.idebuild.ApkSigningButton android:id="@+id/signApkButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:background="@drawable/devxyz_reference_button_v2" android:text="APK Signer" android:textColor="@color/devxyz_text"/><com.jepongdevxyz.idebuild.DeveloperToolsButton android:id="@+id/developerToolsButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:background="@drawable/devxyz_reference_button_v2" android:text="Developer Tools" android:textColor="@color/devxyz_text"/></LinearLayout></ScrollView>
    <ScrollView android:id="@+id/workspace_more" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/devxyz_bg" android:visibility="gone"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SETTINGS" android:textColor="@color/devxyz_cyan" android:textSize="20sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/devxyz_workspace_panel_v2" android:padding="12dp" android:text="Editor • Build • App • Toolchain" android:textColor="@color/devxyz_muted" android:textSize="12sp"/><com.jepongdevxyz.idebuild.EditorSettingsButton android:id="@+id/settingsButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="10dp" android:background="@drawable/devxyz_reference_button_v2" android:text="Editor Settings" android:textColor="@color/devxyz_text"/><com.jepongdevxyz.idebuild.ProjectSettingsButton android:id="@+id/projectSettingsButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:background="@drawable/devxyz_reference_button_v2" android:text="Project Settings" android:textColor="@color/devxyz_text"/><Button android:id="@+id/toolchainButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:background="@drawable/devxyz_reference_button_v2" android:text="Toolchain" android:textColor="@color/devxyz_text"/><com.jepongdevxyz.idebuild.ToolchainManagerButton android:id="@+id/sdkManagerButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:background="@drawable/devxyz_reference_button_v2" android:text="SDK Manager" android:textColor="@color/devxyz_text"/><Button android:id="@+id/runtimeButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:background="@drawable/devxyz_reference_button_v2" android:text="Runtime" android:textColor="@color/devxyz_text"/><Button android:id="@+id/backupButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:background="@drawable/devxyz_reference_button_v2" android:text="Backup Project" android:textColor="@color/devxyz_text"/></LinearLayout></ScrollView>
  </FrameLayout>
  <LinearLayout android:id="@+id/bottomNavigation" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/devxyz_bottom_bar_v2" android:gravity="center" android:orientation="horizontal" android:padding="3dp"><com.jepongdevxyz.idebuild.WorkspaceNavigationButton android:id="@+id/nav_files" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/devxyz_nav_button" android:text="Files"/><com.jepongdevxyz.idebuild.WorkspaceNavigationButton android:id="@+id/nav_search" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/devxyz_nav_button" android:text="Search"/><com.jepongdevxyz.idebuild.WorkspaceNavigationButton android:id="@+id/nav_git" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/devxyz_nav_button" android:text="Git"/><com.jepongdevxyz.idebuild.WorkspaceNavigationButton android:id="@+id/nav_build_tools" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/devxyz_nav_button" android:text="Build"/><com.jepongdevxyz.idebuild.WorkspaceNavigationButton android:id="@+id/nav_more" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/devxyz_nav_button" android:text="More"/></LinearLayout>
