        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/devxyz_line"/>
        <LinearLayout android:id="@+id/editorPane" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.62" android:background="@color/devxyz_bg" android:orientation="vertical">
          <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:orientation="horizontal" android:paddingLeft="4dp" android:paddingRight="4dp"><Button android:id="@+id/saveButton" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:background="@drawable/devxyz_nav_button" android:text="Save" android:textColor="@color/devxyz_muted"/><Button android:id="@+id/saveAllButton" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:background="@drawable/devxyz_nav_button" android:text="Save All" android:textColor="@color/devxyz_muted"/><com.jepongdevxyz.idebuild.CompletionButton android:id="@+id/completionButton" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:background="@drawable/devxyz_nav_button" android:text="Complete" android:textColor="@color/devxyz_muted"/><com.jepongdevxyz.idebuild.EditorActionsButton android:id="@+id/editorActionsButton" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:background="@drawable/devxyz_nav_button" android:text="Actions" android:textColor="@color/devxyz_muted"/></LinearLayout>
          <LinearLayout android:id="@+id/workspace_editor" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"><com.jepongdevxyz.idebuild.SyntaxEditText android:id="@+id/editor" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/devxyz_bg" android:gravity="top|start" android:inputType="textMultiLine|textNoSuggestions" android:padding="10dp" android:textColor="@color/devxyz_text" android:textSize="13sp" android:typeface="monospace"/></LinearLayout>
          <LinearLayout android:id="@+id/editorBottomNavigation" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/devxyz_bottom_bar_v2" android:gravity="center" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Code" android:textColor="@color/devxyz_cyan"/><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Terminal" android:textColor="@color/devxyz_muted"/><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Log" android:textColor="@color/devxyz_muted"/><Button android:id="@+id/problemsButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/devxyz_nav_button" android:text="Problems" android:textColor="@color/devxyz_muted"/></LinearLayout>
        </LinearLayout>
