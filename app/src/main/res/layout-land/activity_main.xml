<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/devxyz_bg" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/devxyz_panel" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="DevxyzIDE  •  CODE • BUILD • CREATE" android:textColor="@color/devxyz_text" android:textSize="17sp" android:textStyle="bold" />
        <Button android:id="@+id/createProjectButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+" />
    </LinearLayout>
    <TextView android:id="@+id/projectPath" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/devxyz_panel" android:ellipsize="middle" android:maxLines="1" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingBottom="4dp" android:text="@string/no_project" android:textColor="@color/devxyz_muted" android:textSize="11sp" />
    <HorizontalScrollView android:id="@+id/tabScroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/devxyz_panel_2" android:scrollbars="none"><LinearLayout android:id="@+id/tabBar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="6dp" android:paddingEnd="6dp" /></HorizontalScrollView>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/workspace_files" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
            <LinearLayout android:id="@+id/workspaceBody" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:baselineAligned="false" android:orientation="horizontal">
                <LinearLayout android:id="@+id/project_pane" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.30" android:background="@color/devxyz_panel" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="6dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="PROJECT EXPLORER" android:textColor="@color/devxyz_text" android:textStyle="bold"/><Button android:id="@+id/newFileButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:enabled="false" android:text="+"/><Button android:id="@+id/newFolderButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:enabled="false" android:text="▣"/></LinearLayout>
                    <ListView android:id="@+id/fileList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@color/devxyz_line" android:dividerHeight="1dp" />
                </LinearLayout>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/devxyz_line" />
                <LinearLayout android:id="@+id/workspace_editor" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.70" android:background="@color/devxyz_bg" android:orientation="vertical">
                    <com.jepongdevxyz.idebuild.SyntaxEditText android:id="@+id/editor" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@color/devxyz_bg" android:gravity="top|start" android:inputType="textMultiLine|textNoSuggestions" android:textColor="@color/devxyz_text" android:textSize="13sp" android:typeface="monospace" android:padding="10dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/devxyz_panel_2" android:gravity="center" android:orientation="horizontal"><Button android:id="@+id/saveButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:enabled="false" android:text="Save"/><Button android:id="@+id/saveAllButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:enabled="false" android:text="Save All"/><com.jepongdevxyz.idebuild.CompletionButton android:id="@+id/completionButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Complete"/><com.jepongdevxyz.idebuild.EditorActionsButton android:id="@+id/editorActionsButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Actions"/></LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="78dp" android:background="@color/devxyz_panel_2" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="4dp" android:text="LOG / PROBLEMS" android:textColor="@color/devxyz_muted" android:textSize="10sp"/><ScrollView android:id="@+id/consoleScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><TextView android:id="@+id/consoleText" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="6dp" android:text="DevxyzIDE ready. Create or import an Android project to begin." android:textColor="@color/devxyz_text" android:textSize="10sp" android:typeface="monospace"/></ScrollView></LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/workspace_build_tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/devxyz_bg" android:orientation="vertical" android:padding="12dp" android:visibility="gone"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="BUILD &amp; TOOLS" android:textColor="@color/devxyz_accent" android:textSize="18sp" android:textStyle="bold"/></LinearLayout>
        <LinearLayout android:id="@+id/workspace_more" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/devxyz_bg" android:orientation="vertical" android:padding="12dp" android:visibility="gone"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MORE / SETTINGS" android:textColor="@color/devxyz_accent" android:textSize="18sp" android:textStyle="bold"/></LinearLayout>
    </FrameLayout>

    <LinearLayout android:id="@+id/bottomNavigation" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/devxyz_panel" android:gravity="center" android:orientation="horizontal" android:padding="2dp"><Button android:id="@+id/nav_files" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Files"/><Button android:id="@+id/nav_search" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Search"/><Button android:id="@+id/nav_git" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Git"/><Button android:id="@+id/nav_build_tools" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Build"/><Button android:id="@+id/nav_more" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="More"/></LinearLayout>

    <LinearLayout android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"><Button android:id="@+id/recentProjectsButton" android:layout_width="1dp" android:layout_height="1dp"/><com.jepongdevxyz.idebuild.CancelableImportButton android:id="@+id/importButton" android:layout_width="1dp" android:layout_height="1dp"/><Button android:id="@+id/backupButton" android:layout_width="1dp" android:layout_height="1dp"/><Button android:id="@+id/toolchainButton" android:layout_width="1dp" android:layout_height="1dp"/><com.jepongdevxyz.idebuild.ToolchainManagerButton android:id="@+id/sdkManagerButton" android:layout_width="1dp" android:layout_height="1dp"/><Button android:id="@+id/runtimeButton" android:layout_width="1dp" android:layout_height="1dp"/><com.jepongdevxyz.idebuild.TerminalButton android:id="@+id/terminalButton" android:layout_width="1dp" android:layout_height="1dp"/><com.jepongdevxyz.idebuild.ApkSigningButton android:id="@+id/signApkButton" android:layout_width="1dp" android:layout_height="1dp"/><com.jepongdevxyz.idebuild.DeveloperToolsButton android:id="@+id/developerToolsButton" android:layout_width="1dp" android:layout_height="1dp"/><com.jepongdevxyz.idebuild.ProjectSettingsButton android:id="@+id/projectSettingsButton" android:layout_width="1dp" android:layout_height="1dp"/><Button android:id="@+id/projectSearchButton" android:layout_width="1dp" android:layout_height="1dp"/><Button android:id="@+id/searchButton" android:layout_width="1dp" android:layout_height="1dp"/><com.jepongdevxyz.idebuild.GitButton android:id="@+id/gitButton" android:layout_width="1dp" android:layout_height="1dp"/><com.jepongdevxyz.idebuild.BuildActionsButton android:id="@+id/buildActionsButton" android:layout_width="1dp" android:layout_height="1dp"/><com.jepongdevxyz.idebuild.EditorSettingsButton android:id="@+id/settingsButton" android:layout_width="1dp" android:layout_height="1dp"/><Button android:id="@+id/buildButton" android:layout_width="1dp" android:layout_height="1dp"/><Button android:id="@+id/problemsButton" android:layout_width="1dp" android:layout_height="1dp"/><Button android:id="@+id/installButton" android:layout_width="1dp" android:layout_height="1dp"/></LinearLayout>
</LinearLayout>
